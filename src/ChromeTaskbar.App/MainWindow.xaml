<Window x:Class="ChromeTaskbar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChromeTaskbar.App"
        Title="Chrome Taskbar" Icon="Assets/app.ico"
        Width="{x:Static local:BarLayout.DefaultWidth}" Height="{x:Static local:BarLayout.MinHeight}"
        MinWidth="{x:Static local:BarLayout.MinWidthWithSideBar}" MinHeight="{x:Static local:BarLayout.MinHeight}"
        ShowActivated="False" ShowInTaskbar="True" Topmost="False"
        UseLayoutRounding="True" WindowStyle="None" ResizeMode="CanResize" Background="White"
        BorderBrush="#FFC8C8C8" BorderThickness="1">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <!-- DataContext: TaskbarViewModel. Pointer/timer wiring lives in MainWindow.xaml.cs (plan-external host glue). -->
    <DockPanel x:Name="Root" LastChildFill="True">
        <!-- Grip on the short side (left when landscape, top when portrait; switched in code-behind):
             drag to move; close button only (no min/max). -->
        <Border x:Name="GripBar" DockPanel.Dock="Left" Width="24" Background="#FFE4E4E4"
                Cursor="SizeAll" MouseLeftButtonDown="OnGripMouseDown">
            <Button x:Name="CloseButton" Width="24" Height="24" Content="✕" FontSize="11"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="Arrow"
                    ToolTip="閉じる" AutomationProperties.Name="閉じる" Focusable="False" Click="OnCloseClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFE81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>
        <!-- Transparent background makes the gaps hit-testable for drag-move. -->
        <Grid Background="Transparent" PreviewMouseLeftButtonDown="OnContentMouseDown" PreviewMouseMove="OnContentMouseMove">
        <!-- Fixed-size cells wrap; ItemWidth (Tag) is stretched to the list width in code-behind. GrowToFit enlarges the
             long side after resizes / additions. Scrollbar hidden; wheel scrolling still works. -->
        <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="ButtonsList" ItemsSource="{Binding Buttons}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel ItemWidth="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Height="{x:Static local:BarLayout.ButtonHeight}"
                            Margin="{x:Static local:BarLayout.ButtonMarginThickness}" Focusable="False"
                            HorizontalContentAlignment="Stretch" Padding="4,0"
                            MouseEnter="OnButtonEnter" MouseLeave="OnButtonLeave"
                            Command="{Binding DataContext.ClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Key}">
                        <DockPanel>
                            <!-- Identicon of the leftmost tab's title; empty slot keeps alignment until it is known. -->
                            <Image DockPanel.Dock="Left" Width="{x:Static local:BarLayout.IconSize}" Height="{x:Static local:BarLayout.IconSize}"
                                   Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.EdgeMode="Aliased"
                                   Source="{Binding Icon}" ToolTip="{Binding IconTitle}"/>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
        <!-- Card popup: transparent margin hosts the drop shadow; rounded corners. -->
        <Popup x:Name="TabPopup" StaysOpen="True" AllowsTransparency="True" Placement="Top" PopupAnimation="Fade">
            <Border x:Name="PopupRoot" Margin="10" Background="#FFFBFBFC" BorderBrush="#FFD6D8DC" BorderThickness="1"
                    CornerRadius="10" MinWidth="240" MaxWidth="480" MaxHeight="420"
                    MouseEnter="OnPopupEnter" MouseLeave="OnPopupLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.22" Color="Black"/>
                </Border.Effect>
                <DockPanel Margin="6">
                    <TextBlock x:Name="PopupStatus" DockPanel.Dock="Top" Margin="8,4,8,6" TextWrapping="Wrap"
                               FontSize="12" Foreground="#FF5F6368">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ListBox x:Name="TabList" Focusable="False" BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             VirtualizingPanel.IsVirtualizing="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <!-- Strip ListBox selection chrome; the row button draws its own states. -->
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="TabButton" IsEnabled="{Binding CanSelect}" Focusable="False"
                                        Cursor="Hand" ToolTip="{Binding Title}" Click="OnTabClick">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="8,6">
                                                <DockPanel>
                                                    <Border x:Name="Accent" DockPanel.Dock="Left" Width="3" CornerRadius="1.5"
                                                            Margin="0,1,8,1" Background="Transparent"/>
                                                    <Image DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,10,0"
                                                           VerticalAlignment="Center" RenderOptions.EdgeMode="Aliased"
                                                           Source="{Binding Icon}">
                                                        <Image.Clip>
                                                            <RectangleGeometry Rect="0,0,16,16" RadiusX="3" RadiusY="3"/>
                                                        </Image.Clip>
                                                    </Image>
                                                    <TextBlock x:Name="Label" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" FontSize="13" Foreground="#FF202124"/>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#FFE8F0FE"/>
                                                    <Setter TargetName="Accent" Property="Background" Value="#FF1A73E8"/>
                                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                                    <Setter TargetName="Label" Property="Foreground" Value="#FF174EA6"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#FFEDEFF2"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#FFDDE1E6"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Label" Property="Foreground" Value="#FF9AA0A6"/>
                                                    <Setter Property="Cursor" Value="Arrow"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Popup>
        </Grid>
    </DockPanel>
</Window>
